# SpecLens AI - Backend Environment Configuration
# Copy this file to .env and provide your actual API keys.
# NEVER commit the .env file or expose these credentials to the client/frontend.

# Application Settings
PROJECT_NAME="SpecLens AI"
VERSION="0.1.0"
API_V1_PREFIX="/api"

# Max Upload Size in Bytes (Default: 25MB = 26214400 bytes)
MAX_UPLOAD_SIZE_BYTES=26214400

# ==============================================================================
# Nebius Token Factory / NVIDIA Open Models (Server-Side Inference)
# ==============================================================================
# Nebius Token Factory (formerly Nebius AI Studio) provides an OpenAI-compatible
# API endpoint for high-performance NVIDIA models.
#
# Obtain your API key from the Nebius console (https://tokenfactory.nebius.com/ or https://studio.nebius.ai/)
NEBIUS_API_KEY=

# Nebius Token Factory API Base URL
# Default: https://api.tokenfactory.nebius.com/v1
# Studio fallback: https://api.studio.nebius.ai/v1
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1"

# NVIDIA model identifier on Nebius Token Factory
# Supported examples include:
# - nvidia/nemotron-3-nano-30b
# - nvidia/nemotron-3-super-120b
# - nvidia/nemotron-nano-2-vl
# - nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
NEBIUS_MODEL="nvidia/nemotron-3-nano-30b"
